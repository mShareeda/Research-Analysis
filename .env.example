DATABASE_URL="file:./dev.db"
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY="sk-or-v1-your-key"
OPENROUTER_MODEL="openrouter/auto"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Research Analysis"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
UPLOAD_DIR="./uploads"
MAX_SOURCE_CHARS="60000"

# Locks the whole app behind HTTP Basic Auth (src/middleware.ts) when set.
# Leave empty locally to develop without a password. In production this is
# set in hPanel's Environment variables panel, never in a committed file.
SITE_PASSWORD=""
