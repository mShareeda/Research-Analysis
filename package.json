{
  "name": "research-analysis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/local/schema.prisma && next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate:local": "prisma generate --schema=prisma/local/schema.prisma",
    "prisma:migrate:local": "prisma migrate dev --schema=prisma/local/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "cheerio": "^1.1.2",
    "franc-min": "^6.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.10.0",
    "next": "16.3.3",
    "openai": "^6.7.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
